# Server-side only. No VITE_ prefix - a VITE_ var would be inlined into the
# client bundle and readable by anyone visiting the site.
# Read by api/watchmode.ts. Local dev requires `vercel dev` to run the function.
WATCHMODE_API_KEY=your_watchmode_api_key_here

# TMDB integration is commented out in src/services/streamingService.ts.
# Uncomment only if you re-enable that code path.
# TMDB_API_KEY=your_tmdb_api_key_here
